# Copie para apps/restaurante/.env.local e preencha com os dados do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Nome do cookie de sessão — diferente em cada app para poder logar nos dois ao mesmo tempo no localhost
NEXT_PUBLIC_LEEVA_AUTH_COOKIE=sb-leeva-restaurante

