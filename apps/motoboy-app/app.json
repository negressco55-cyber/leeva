{
  "expo": {
    "name": "Leeva Motoboy",
    "slug": "leeva-motoboy",
    "scheme": "leevamotoboy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#141513",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.leeva.motoboy",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O Leeva usa sua localização para te oferecer entregas próximas e mostrar sua posição durante a entrega.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "O Leeva usa sua localização durante as entregas."
      }
    },
    "android": {
      "package": "br.com.leeva.motoboy",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#141513",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "POST_NOTIFICATIONS"]
    },
    "plugins": [
      "expo-font",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Leeva usa sua localização para te oferecer entregas próximas."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
