# =====================================================================
# LEEVA — variáveis de ambiente
# Copie para apps/restaurante/.env.local e apps/motoboy/.env.local.
# =====================================================================

# ---- Supabase (obrigatório) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # SECRETO — só servidor

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000    # 3001 no app do motoboy
# nome do cookie de sessão — DIFERENTE em cada app (permite logar nos dois no localhost)
NEXT_PUBLIC_LEEVA_AUTH_COOKIE=sb-leeva-restaurante   # sb-leeva-motoboy no outro

# =====================================================================
# FASE 2 — tudo abaixo é OPCIONAL. Sem isso o Leeva funciona com:
#  - distância/tempo por estimativa (linha reta)
#  - notificações só in-app
#  - integrações externas marcadas como PREPARADO
# =====================================================================

# ---- Rotas reais (senão usa linha reta) ----
OSRM_BASE_URL=                        # ex: https://router.project-osrm.org

# ---- IA (leitura de mensagem do WhatsApp por LLM; senão heurística) ----
ANTHROPIC_API_KEY=

# ---- iFood (PREPARADO) ----
IFOOD_ACCESS_TOKEN=
IFOOD_WEBHOOK_SECRET=

# ---- WhatsApp Cloud API (PREPARADO) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ---- SMS via Twilio (PREPARADO) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Web Push (PREPARADO) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Cardápio próprio / API de pedidos / API de logística (/api/v1/deliveries) ----
LEEVA_API_KEY=                        # dev: chave global (restaurante único)

# ---- Cron de retenção E do despacho automático (/api/cron/dispatch-tick) ----
CRON_SECRET=                          # obrigatório em produção p/ rodar o motor de despacho

# =====================================================================
# FASE 3 — também OPCIONAL. Sem isso:
#  - mapa usa tiles OSM + geocoding Nominatim (sem chave)
#  - cobrança SaaS calcula estimativa mas não cobra de verdade
# =====================================================================

# ---- Mapa (senão OSM/Nominatim) ----
MAPBOX_TOKEN=

# =====================================================================
# FASE 3.5 — go-live, admin, reputação
# =====================================================================

# ---- Painel admin (apps/admin, porta 3002) ----
# use NEXT_PUBLIC_LEEVA_AUTH_COOKIE=sb-leeva-admin nesse app
LEEVA_EXTERNAL_COSTS=0        # custo externo mensal estimado (infra/gateway/mapas) p/ o financeiro admin

# ---- Monitoramento (opcional) ----
SENTRY_DSN=                   # sem isso, erros vão só para error_events + console

# ---- Cron real do despacho ----
# CRON_SECRET (acima) é OBRIGATÓRIO em produção.
# Agendar uma vez no SQL Editor do Supabase:
#   select public.configure_dispatch_cron('https://SEU-APP/api/cron/dispatch-tick', 'CRON_SECRET', '30 seconds');

# ---- Geração de tipos ----
LEEVA_PROJECT_ID=                     # ref do projeto Supabase (para npm run db:types)
